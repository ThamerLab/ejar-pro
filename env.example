# Copy to .env. Never commit real credentials.
# Generate a secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_STRONG_PASSWORD
# Localhost only is safest. Change only behind trusted reverse proxy/firewall.
BIND_IP=127.0.0.1
APP_PORT=9090
SECURE_COOKIES=false
DB_PATH=/data/ejar.db
